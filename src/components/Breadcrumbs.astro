---
type Crumb = {
  label: string;
  href?: string;
};

const { items } = Astro.props as { items: Crumb[] };
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-2 text-[0.82rem] text-[color:var(--faint)]">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span aria-hidden="true" class="text-[color:var(--faint)]">/</span>}
        {item.href ? (
          <a class="transition hover:text-[color:var(--text)]" href={item.href}>
            {item.label}
          </a>
        ) : (
          <span class="text-[color:var(--text)]">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
