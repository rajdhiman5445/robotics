---
const { src, alt, caption } = Astro.props as {
  src: string;
  alt: string;
  caption?: string;
};
---

<figure class="my-8">
  <img class="w-full" src={src} alt={alt} loading="lazy" />
  {caption && <figcaption class="mt-3 text-sm leading-6 text-[color:var(--faint)]">{caption}</figcaption>}
</figure>
