---
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';
import PomodoroTimer from '../components/PomodoroTimer.astro';

const {
  title,
  description = 'Robotics knowledge base',
  pathname = '/',
  showHeader = true,
  pageMeta,
} = Astro.props as {
  title: string;
  description?: string;
  pathname?: string;
  showHeader?: boolean;
  pageMeta?: {
    href: string;
    title: string;
    path?: string;
    kind?: 'document' | 'navigator' | 'utility';
  };
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body
    data-wiki-page-href={pageMeta?.href}
    data-wiki-page-title={pageMeta?.title}
    data-wiki-page-path={pageMeta?.path}
    data-wiki-page-kind={pageMeta?.kind}
  >
    <script is:inline>
      const STACK_KEY = 'robotics-nav-stack';
      const RECENTS_KEY = 'robotics-recent-pages-v1';
      const MAX_STACK = 30;
      const MAX_RECENTS = 5;

      const readStack = () => {
        try {
          const raw = sessionStorage.getItem(STACK_KEY);
          const parsed = raw ? JSON.parse(raw) : [];
          return Array.isArray(parsed) ? parsed.filter((entry) => typeof entry === 'string') : [];
        } catch {
          return [];
        }
      };

      const writeStack = (stack) => {
        try {
          sessionStorage.setItem(STACK_KEY, JSON.stringify(stack.slice(-MAX_STACK)));
        } catch {
          // Ignore storage failures.
        }
      };

      const readRecents = () => {
        try {
          const raw = localStorage.getItem(RECENTS_KEY);
          const parsed = raw ? JSON.parse(raw) : [];
          return Array.isArray(parsed)
            ? parsed
                .filter((entry) => entry && typeof entry === 'object' && typeof entry.href === 'string')
                .map((entry) => ({
                  href: entry.href,
                  title: typeof entry.title === 'string' ? entry.title : typeof entry.label === 'string' ? entry.label : 'Page',
                  path: typeof entry.path === 'string' ? entry.path : '',
                  kind:
                    entry.kind === 'navigator' || entry.kind === 'utility'
                      ? entry.kind
                      : 'document',
                  timestamp:
                    typeof entry.timestamp === 'number' ? entry.timestamp : Date.now(),
                }))
            : [];
        } catch {
          return [];
        }
      };

      const writeRecents = (items) => {
        try {
          localStorage.setItem(RECENTS_KEY, JSON.stringify(items.slice(0, MAX_RECENTS)));
        } catch {
          // Ignore storage failures.
        }
      };

      const currentHref = () => `${window.location.pathname}${window.location.search}`;
      const normalizeHref = (href) => {
        if (!href) return '';
        try {
          const url = new URL(href, window.location.origin);
          return `${url.pathname}${url.search}`;
        } catch {
          return href;
        }
      };

      const pushCurrent = () => {
        const stack = readStack();
        const current = currentHref();
        if (stack[stack.length - 1] !== current) {
          stack.push(current);
          writeStack(stack);
        }
      };

      const recordRecent = () => {
        const href = normalizeHref(document.body.dataset.wikiPageHref || currentHref());
        const title = document.body.dataset.wikiPageTitle || document.title.replace(/\s*·\s*Robotics Wiki\s*$/, '').trim();
        const path = document.body.dataset.wikiPagePath || '';
        const kind = document.body.dataset.wikiPageKind || 'document';

        if (!href || kind !== 'document') return;

        const items = readRecents().filter((item) => item.href !== href);
        items.unshift({
          href,
          title: title || 'Page',
          path,
          kind,
          timestamp: Date.now(),
        });
        writeRecents(items);
        window.__wikiRecentPages = items;
      };

      window.__wikiNavigate = (href) => {
        if (!href) return;
        if (href === currentHref()) return;
        pushCurrent();
        window.location.assign(href);
        return true;
      };

      window.__wikiGoBack = () => {
        const stack = readStack();
        const target = stack.pop();
        if (!target) return false;
        writeStack(stack);
        window.location.assign(target);
        return true;
      };

      window.__wikiGetRecentPages = () => readRecents();

      const isTypingTarget = (target) => {
        if (!(target instanceof HTMLElement)) return false;
        if (target.isContentEditable) return true;
        const tag = target.tagName;
        return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
      };

      window.addEventListener(
        'click',
        (event) => {
          if (event.defaultPrevented) return;
          if (event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

          const target = event.target;
          const anchor = target instanceof Element ? target.closest('a[href]') : null;
          if (!anchor) return;
          if (anchor.getAttribute('target') === '_blank') return;

          const href = anchor.getAttribute('href');
          if (!href || href.startsWith('#')) return;

          const url = new URL(href, window.location.origin);
          if (url.origin !== window.location.origin) return;
          if (url.pathname === window.location.pathname && url.search === window.location.search && url.hash) return;

          event.preventDefault();
          window.__wikiNavigate(`${url.pathname}${url.search}`);
        },
        true,
      );

      window.addEventListener('keydown', (event) => {
        if (event.defaultPrevented) return;
        if (event.ctrlKey && event.code === 'KeyK') {
          event.preventDefault();
          window.__wikiToggleCommandPalette?.();
          return;
        }

        if (event.metaKey || event.ctrlKey) return;

        const target = event.target;
        const typing = isTypingTarget(target);

        const slashShortcut = event.key === '/' && !event.altKey;
        const altSlashShortcut = event.altKey && event.code === 'Slash';

        if (!slashShortcut && !altSlashShortcut) return;
        if (typing && !altSlashShortcut) return;

        event.preventDefault();
        window.__wikiNavigate('/search/');
      });

      window.addEventListener('keydown', (event) => {
        if (event.defaultPrevented) return;
        if (event.key !== 'Escape') return;
        if (document.body.dataset.commandPaletteOpen === 'true') return;
        if (document.body.dataset.readingSettingsOpen === 'true') return;

        const target = event.target;
        if (isTypingTarget(target)) return;

        event.preventDefault();
        if (!window.__wikiGoBack?.()) {
          window.location.assign('/');
        }
      });

      window.addEventListener('DOMContentLoaded', () => {
        recordRecent();
      });
    </script>

    {showHeader && pathname !== '/' && (
      <header data-reading-ui="topbar" class="border-b border-white/5">
        <div class="mx-auto flex h-14 max-w-[1600px] items-center px-4 sm:px-6 lg:px-8">
          <a href="/" class="text-[0.95rem] font-medium tracking-[-0.01em] text-[color:var(--text)]">
            Robotics
          </a>
        </div>
      </header>
    )}
    <slot />
    <CommandPalette />
    <PomodoroTimer />
  </body>
</html>
